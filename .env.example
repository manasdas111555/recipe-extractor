# Universal Pro AI - Environment Configuration Template
# =========================================================

# Application Core Settings
PROJECT_NAME="Universal Pro AI - API Gateway"
ENVIRONMENT="development"
DEBUG=true
SECRET_KEY="universal_pro_default_secret_key_2026"
ADMIN_API_KEY="your_secure_admin_api_key_here"

# Proxy Trust Configuration
# Set TRUSTED_PROXY=false for local development (ignores spoofed proxy headers).
# Set TRUSTED_PROXY=true in production/staging when deployed behind Vercel or Cloudflare.
TRUSTED_PROXY=false
TRUSTED_PROXY_HOPS=1

# Supabase Managed Database
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# AI Multimodal Providers
GEMINI_API_KEY="your-gemini-api-key"
GROQ_API_KEY="your-groq-api-key"
MISTRALAI_API_KEY="your-mistral-api-key"

# Monetization & Affiliate Identifiers
AMAZON_AFFILIATE_TAG="manasdas11155-21"
EARNKARO_ID="5608766"

# Chat Webhook Secrets
TELEGRAM_BOT_SECRET_TOKEN="your_telegram_webhook_secret_token"
WHATSAPP_APP_SECRET="your_whatsapp_app_secret"
